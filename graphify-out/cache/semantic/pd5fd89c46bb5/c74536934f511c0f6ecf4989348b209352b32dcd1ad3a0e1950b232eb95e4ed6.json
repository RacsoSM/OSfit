{"nodes": [{"id": "docs_superpowers_specs_2026_08_27_resumen_cliente_video_animado_design_escenaresumen", "label": "EscenaResumen", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-27-resumen-cliente-video-animado-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reemplaza TarjetaResumen: el video pasa de tarjetas estaticas a una animacion continua estilo Spotify Wrapped, con Saludo como escena nueva."}, {"id": "docs_superpowers_specs_2026_08_27_resumen_cliente_video_animado_design_timelineresumen", "label": "TimelineResumen", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-27-resumen-cliente-video-animado-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Puramente aritmetico sobre Long/List, sin Android, para ser testeable en JVM igual que ResumenClienteCalculator. El crossfade de 600ms es un truco de rendering, no de tiempo: no agrega relleno al cursor."}, {"id": "docs_superpowers_specs_2026_08_27_resumen_cliente_video_animado_design_blobsgeometria", "label": "BlobsGeometria", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-27-resumen-cliente-video-animado-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Determinista sin Random para poder testearse en JVM sin Android; movimiento seno/coseno lento de periodo 8-15s."}, {"id": "docs_superpowers_specs_2026_08_27_resumen_cliente_video_animado_design_fondoblobrenderer", "label": "FondoBlobRenderer", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-27-resumen-cliente-video-animado-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Se dibuja una sola vez por frame con el tiempo GLOBAL del video para que los blobs nunca se corten ni reinicien entre escenas."}, {"id": "docs_superpowers_specs_2026_08_27_resumen_cliente_video_animado_design_blurmaskfilter", "label": "Blur con BlurMaskFilter (no RenderEffect)", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-08-27-resumen-cliente-video-animado-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RenderEffect solo compone sobre canvas de hardware (lockHardwareCanvas), lo que habria obligado a redisenar el pipeline. BlurMaskFilter da blur gaussiano real sobre canvas de software, existe desde API 1 (muy por debajo de minSdk 26) y evita ramificar por version de Android."}, {"id": "docs_superpowers_specs_2026_08_27_resumen_cliente_video_animado_design_maquinaescribir", "label": "MaquinaEscribir", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-27-resumen-cliente-video-animado-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Funcion pura String/Long -> String reutilizada para escritura lenta y rapida; solo cambia duracionMs."}, {"id": "docs_superpowers_specs_2026_08_27_resumen_cliente_video_animado_design_resumenframerenderer", "label": "ResumenFrameRenderer", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-27-resumen-cliente-video-animado-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reemplaza ResumenCardRenderer. Solo el texto crossfadea (el fondo es una capa compartida) porque renderizar dos escenas completas y mezclarlas a nivel de pixeles seria caro."}, {"id": "docs_superpowers_specs_2026_08_27_resumen_cliente_video_animado_design_resumenvideogenerator", "label": "ResumenVideoGenerator", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-27-resumen-cliente-video-animado-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_08_27_resumen_cliente_video_animado_design_resolucion_1080x1920", "label": "Resolucion fija 1080x1920", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-08-27-resumen-cliente-video-animado-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "El video se genera en el celular del entrenador sin servidor; 4K real cuadruplicaria el costo de codificacion sin beneficio visible en un telefono."}], "edges": [{"source": "docs_superpowers_specs_2026_08_27_resumen_cliente_video_animado_design_escenaresumen", "target": "docs_superpowers_specs_2026_08_26_resumen_cliente_video_design_tarjetaresumen", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-27-resumen-cliente-video-animado-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_08_27_resumen_cliente_video_animado_design_resumenframerenderer", "target": "docs_superpowers_specs_2026_08_26_resumen_cliente_video_design_resumencardrenderer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-27-resumen-cliente-video-animado-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_08_27_resumen_cliente_video_animado_design_resumenframerenderer", "target": "docs_superpowers_specs_2026_08_27_resumen_cliente_video_animado_design_timelineresumen", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-27-resumen-cliente-video-animado-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_08_27_resumen_cliente_video_animado_design_resumenframerenderer", "target": "docs_superpowers_specs_2026_08_27_resumen_cliente