{"nodes": [{"id": "docs_superpowers_specs_2026_09_21_reinicio_semanal_rutina_design", "label": "Spec: Reinicio semanal del ciclo de rutina", "file_type": "document", "source_file": "docs/superpowers/specs/2026-09-21-reinicio-semanal-rutina-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_09_21_reinicio_semanal_rutina_design_reinicio_semanal", "label": "reinicioSemanal (Rutina flag)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-21-reinicio-semanal-rutina-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Un booleano explicito en vez de deducir por 5 dias, grupo muscular o heuristica de nombreDia: no depende del texto libre y evita pierna dos dias seguidos."}, {"id": "docs_superpowers_specs_2026_09_21_reinicio_semanal_rutina_design_ancla_efectiva", "label": "anclaEfectiva (ancla al domingo anterior)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-21-reinicio-semanal-rutina-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "El ancla es exclusiva, por eso se fecha en domingo y las asistencias del lunes ya cuentan."}, {"id": "docs_superpowers_specs_2026_09_21_reinicio_semanal_rutina_design_diaquetoca_sealed", "label": "DiaQueToca sealed type (Dia/Descanso/SinRutina)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-21-reinicio-semanal-rutina-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "diaQueToca devolvia Int y no podia decir 'hoy no hay dia'; un tipo sellado obliga a todos los sitios de llamada a manejar Descanso. Se descarto semanaCompleta() aparte por riesgo de desincronizacion."}, {"id": "docs_superpowers_specs_2026_09_21_reinicio_semanal_rutina_design_semana_completa", "label": "Estado 'Semana completa' en Tomar Asistencia", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-21-reinicio-semanal-rutina-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Se guarda asistio=true con diaRutinaRealizado=null: cuenta para la racha y no mueve el ciclo."}, {"id": "docs_superpowers_specs_2026_09_21_reinicio_semanal_rutina_design_contrato_gemelo_dia", "label": "Contrato gemelo interpretar/denormalizar (dia.ts vs Kotlin)", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-09-21-reinicio-semanal-rutina-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "interpretar(denormalizar(c,a,hoy),totalDias,d)==diaQueToca(c,a,d); no truncar fechas al lunes por la semana ISO."}, {"id": "docs_superpowers_specs_2026_09_21_reinicio_semanal_rutina_design_cambiar_dia_function", "label": "Cloud Function cambiarDia (ancla fechada ayer)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-21-reinicio-semanal-rutina-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_superpowers_specs_2026_09_21_reinicio_semanal_rutina_design", "target": "docs_superpowers_specs_2026_09_02_calendario_rutina_como_ley_design", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-09-21-reinicio-semanal-rutina-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_09_21_reinicio_semanal_rutina_design", "target": "docs_superpowers_specs_2026_09_21_reinicio_semanal_rutina_design_reinicio_semanal", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-09-21-reinicio-semanal-rutina-design.md", "source_lo