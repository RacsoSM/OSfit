s_design_reglas_firestore", "label": "Reglas de Firestore por claim (esEntrenador / esCliente)", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-09-10-web-clientes-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Las reglas 'auth != null' no sobreviven a sesiones de cliente. UID_ENTRENADOR literal: es identificador, no credencial."}, {"id": "docs_superpowers_specs_2026_09_10_web_clientes_design_claim_clienteid", "label": "Custom claim clienteId", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-10-web-clientes-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_09_10_web_clientes_design_reglas_storage", "label": "Reglas de Storage (insignias, resumenes)", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-09-10-web-clientes-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Firebase Storage sobre Cloudflare R2: el mismo claim autoriza Firestore y videos sin URLs firmadas."}, {"id": "docs_superpowers_specs_2026_09_10_web_clientes_design_cambiodiaweb", "label": "CambioDiaWeb (cambiosDia/{clienteId}_{fecha})", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-10-web-clientes-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_09_10_web_clientes_design_videopublicado", "label": "VideoPublicado (clientes/{id}/videos)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-10-web-clientes-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_09_10_web_clientes_design_justificadaporcliente", "label": "Asistencia.justificadaPor