{"nodes": [{"id": "docs_superpowers_specs_2026_09_02_calendario_rutina_como_ley_design_historial_es_la_ley", "label": "El historial de asistencias es la ley", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-09-02-calendario-rutina-como-ley-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "El dia que le toca a un cliente vivia en tres campos escritos desde tres sitios, un cache con varios escritores y ningun dueno; se deduce del historial en vez de guardarse para eliminar la clase de bug entera."}, {"id": "docs_superpowers_specs_2026_09_02_calendario_rutina_como_ley_design_diaquetoca", "label": "diaQueToca (regla de deduccion)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-02-calendario-rutina-como-ley-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Las faltas guardan diaRutinaRealizado = null, asi que quedan fuera del filtro por construccion: faltar no avanza el ciclo sin necesitar una regla aparte."}, {"id": "docs_superpowers_specs_2026_09_02_calendario_rutina_como_ley_design_ancla", "label": "Ancla fechada (diaActualIndex + diaAnclaFecha)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-02-calendario-rutina-como-ley-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "El ancla corta el historial (solo cuentan asistencias con fecha > diaAnclaFecha) para que un registro viejo no pise una asignacion manual. El registro es historia y el ancla es intencion: que difieran es la semantica buscada, no una desincronizacion."}, {"id": "docs_superpowers_specs_2026_09_02_calendario_rutina_como_ley_design_migracion_congelar", "label": "Migracion por congelacion en FECHA_CORTE", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-09-02-calendario-rutina-como-ley-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nadie debe ver cambiar su dia al actualizar la app. Se evalua la formula vieja en una fecha fija (dia siguiente a FECHA_CORTE) para congelar el resultado; las dos fechas van desplazadas un dia para que ningun registro se cuente dos veces ni se pierda. No requiere escrituras de migracion en Firestore, a costa de no reparar solos los desvios del bug 2."}, {"id": "docs_superpowers_specs_2026_09_02_calendario_rutina_como_ley_design_campos_pendientes_retirados", "label": "Retiro de diaPendienteIndex/diaPendienteFecha", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-02-calendario-rutina-como-ley-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No se borran del modelo todavia porque la migracion los necesita para leer el estado congelado; quedan de solo lectura y obsoletos."}, {"id": "docs_superpowers_specs_2026_09_02_calendario_rutina_como_ley_design_rutinaprogresscalculator", "label": "RutinaProgressCalculator", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-02-calendario-rutina-como-ley-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_superpowers_specs_2026_09_02_calendario_rutina_como_ley_design_historial_es_la_ley", "target": "docs_superpowers_specs_2026_09_02_calendario_rutina_como_ley_design_diaquetoca", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-09-02-calendario-rutina-como-ley-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_09_02_calendario_rutina_como_ley_design_diaquetoca", "target": "docs_superpowers_specs_2026_09_02_calendario_rutina_como_ley_design_ancla", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-09-02-calendario-rutina-como-ley-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_09_02_calendario_rutina_como_ley_design_migracion_congelar", "target": "docs_superpowers_specs_2026_09_02_calendario_rutina_como_ley_design_ancla", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-09-02-calendario-rutina-como-ley-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_09_02_calendario_rutina_como_ley_design_migracion_congelar", "target": "docs_superpowers_specs_2026_09_02_calendario_rutina_como_ley_design_campos_pendientes_retirados", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-09-02-calendario-rutina-como-ley-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_09_02_calendario_rutina_como_ley_design_rutinaprogresscalculator", "target": "docs_superpowers_specs_2026_09_02_calendario_rutina_como_ley_design_diaquetoca", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/superpowers/specs/2026-09-02-calendario-rutina-como-ley-design.md", "source_location": null, "weight": 1.0}], "hyperedges": []}