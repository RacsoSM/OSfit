", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/superpowers/specs/2026-09-10-web-clientes-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_09_04_medallas_logros_design_medallaotorgada", "target": "docs_superpowers_specs_2026_09_10_web_clientes_design_dia_denormalizado", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/superpowers/specs/2026-09-10-web-clientes-design.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "flujo_acceso_web_cliente", "label": "Flujo de acceso y acciones de la web del cliente", "nodes": ["docs_superpowers_specs_2026_09_10_web_clientes_design_accesoweb", "docs_superpowers_specs_2026_09_10_web_clientes_design_endpoint_sesion", "docs_superpowers_specs_2026_09_10_web_clientes_design_reglas_firestore", "docs_superpowers_specs_2026_09_10_web_clientes_design_endpoint_cambiardia", "docs_superpowers_specs_2026_09_10_web_clientes_design_endpoint_revivirracha", "docs_superpowers_specs_2026_09_10_web_clientes_design_avisarfalta"], "relation": "participate_in", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-09-10-web-clientes-design.md"}]}