{"nodes": [{"id": "docs_superpowers_specs_2026_10_08_notificaciones_web_pwa_design", "label": "Spec: Notificaciones web PWA", "file_type": "document", "source_file": "docs/superpowers/specs/2026-10-08-notificaciones-web-pwa-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_10_08_notificaciones_web_pwa_design_pwa_instalable", "label": "PWA instalable (web instalable)", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-08-notificaciones-web-pwa-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "En iOS una web solo recibe push si la clienta la instal\u00f3 en su pantalla de inicio (iOS 16.4+), por eso la web se vuelve PWA."}, {"id": "docs_superpowers_specs_2026_10_08_notificaciones_web_pwa_design_restricciones_ios", "label": "Restricciones de iOS para web push", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-08-notificaciones-web-pwa-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Solo iOS 16.4+, solo con la p\u00e1gina instalada desde Safari, sin aviso autom\u00e1tico de instalaci\u00f3n, permiso solo tras un toque, almacenamiento separado del de Safari."}, {"id": "docs_superpowers_specs_2026_10_08_notificaciones_web_pwa_design_manifest_sin_start_url", "label": "Manifest sin start_url", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-08-notificaciones-web-pwa-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sin start_url la p\u00e1gina instalada abre en /c/<token> y entra por el escal\u00f3n 1 de resolverSesion; agregarlo rompe la sesi\u00f3n de todas las clientas instaladas."}, {"id": "docs_superpowers_specs_2026_10_08_notificaciones_web_pwa_design_dos_llaves"