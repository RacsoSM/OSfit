rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // El entrenador es un UID literal. Con un solo entrenador es más simple y se audita de
    // un vistazo; si algún día hay dos, esto pasa a ser un custom claim.
    function esEntrenador() {
      return request.auth != null &&
             request.auth.uid == 'G8lW4rIgXhZrswQXJ84pT1StFx82';
    }

    // El claim lo pone la función `sesion` al canjear el token del link. No se puede
    // falsificar: viaja dentro de un token firmado por Firebase.
    //
    // El claim solo no basta: una sesión sigue viva aunque el entrenador revoque el acceso.
    // Por eso además tiene que haberse iniciado después del corte (`sesionVigente`).
    function esCliente(cid) {
      return request.auth != null &&
             request.auth.token.clienteId == cid &&
             sesionVigente(cid);
    }

    // GEMELO de `sesionVigente` en functions/src/corteAcceso.ts. `auth_time` es la hora del
    // canje original (segundos, firmada, no cambia al renovarse); `accesoRevocadoEn` lo
    // escribe la función `alRevocarAcceso` al revocar. Sin corte, todo pasa como antes; un
    // link nuevo canjeado después del corte también pasa.
    // Ver docs/superpowers/specs/2026-10-10-revocar-acceso-design.md.
    function vigenteFrente(corte) {
      return corte == null || request.auth.token.auth_time * 1000 > corte.toMillis();
    }

    // Cuesta una lectura extra (el `get`) por consulta. Para el propio documento del cliente
    // se usa `esClienteDelDoc`, que mira `resource.data` y no paga esa lectura.
    function sesionVigente(cid) {
      return vigenteFrente(
        get(/databases/$(database)/documents/clientes/$(cid)).data.get('accesoRevocadoEn', null));
    }

    function esClienteDelDoc(cid) {
      return request.auth != null &&
             request.auth.token.clienteId == cid &&
             vigenteFrente(resource.data.get('accesoRevocadoEn', null));
    }

    match /clientes/{cid} {
      allow read: if esEntrenador() || esClienteDelDoc(cid);
      allow write: if esEntrenador();

      // Los pagos quedan fuera del alcance del cliente a propósito.
      match /pagos/{doc} {
        allow read, write: if esEntrenador();
      }
      match /medallas/{doc} {
        allow read: if esEntrenador() || esCliente(cid);
        allow write: if esEntrenador();
      }
      match /logrosPersonales/{doc} {
        allow read: if esEntrenador() || esCliente(cid);
        allow write: if esEntrenador();
      }
      match /videos/{doc} {
        allow read: if esEntrenador() || esCliente(cid);
        allow write: if esEntrenador();
      }
      // Lo que registra en "Registro". La clienta lee las suyas (su historial y, más
      // adelante, su mapa de fuerza), pero escribe solo la función `registrarSesion` con el
      // Admin SDK: valida los ejercicios contra el banco y los rangos de reps y peso.
      match /sesiones/{doc} {
        allow read: if esEntrenador() || esCliente(cid);
        allow write: if esEntrenador();
      }
      match /personal_records/{doc} {
        allow read, write: if esEntrenador();
      }
      // Los tokens de notificaciones de sus teléfonos. Solo el entrenador: la clienta no
      // necesita leerlos, y el token es lo único que permite mandarle avisos a su teléfono.
      // Los escribe la función `registrarDispositivo` con el Admin SDK.
      match /dispositivos/{doc} {
        allow read, write: if esEntrenador();
      }
    }

    match /asistencias/{doc} {
      allow read: if esEntrenador() ||
                     (resource.data.clienteId == request.auth.token.clienteId &&
                      sesionVigente(request.auth.token.clienteId));
      allow write: if esEntrenador();
    }

    match /cambiosDia/{doc} {
      allow read: if esEntrenador() ||
                     (resource.data.clienteId == request.auth.token.clienteId &&
                      sesionVigente(request.auth.token.clienteId));
      allow write: if esEntrenador();
    }

    // "Hoy no voy a poder ir". El cliente lee el suyo para saber si ya avisó hoy —es lo que
    // mantiene el botón escondido el resto del día aunque recargue—, pero escribir solo lo
    // hace la función `avisarFalta` con el Admin SDK, que no pasa por estas reglas.
    match /avisosFalta/{doc} {
      // Por el id del documento y no por su contenido: el aviso no existe hasta que la
      // clienta avisa, y con `resource` en null una regla que mire `resource.data` deniega
      // la lectura de lo que todavía no está. El id ya lleva el clienteId adelante, y los
      // ids que genera Firestore son alfanuméricos, así que partir por `_` es seguro.
      // Relajarlo a `resource == null` no vale: dejaría probar ids para averiguar si otra
      // clienta avisó.
      allow read: if esEntrenador() ||
                     (doc.split('_')[0] == request.auth.token.clienteId &&
                      sesionVigente(request.auth.token.clienteId));
      allow write: if esEntrenador();
    }

    // La ruleta: una tirada por cliente por mes, con id `{clienteId}_{AAAA-MM}`. El cliente
    // lee la suya —la necesita para saber si ya jugó y para calcular su cupo— pero escribir
    // solo lo hace la función `jugarRuleta` con el Admin SDK, que no pasa por estas reglas.
    //
    // Se autoriza por el ID y no por `resource.data`, a diferencia de las de arriba: acá el
    // documento ausente es el caso normal (casi nadie juega), y una regla que mira
    // `resource.data` no deja leer lo que no existe. Ver entrada 23 de docs/backlog.md.
    match /ruletas/{doc} {
      allow read: if esEntrenador() ||
                     (doc.split('_')[0] == request.auth.token.clienteId &&
                      sesionVigente(request.auth.token.clienteId));
      allow write: if esEntrenador();
    }

    // El token de acceso nunca se expone al navegador: solo lo lee el Admin SDK, que no
    // pasa por estas reglas.
    match /accesosWeb/{token} {
      allow read, write: if esEntrenador();
    }

    // Catálogos y configuración: el cliente no los necesita. Su rutina viaja embebida en su
    // propio documento, así que `rutinas` tampoco hace falta abrirla.
    match /rutinas/{doc} { allow read, write: if esEntrenador(); }
    match /medallas/{doc} { allow read, write: if esEntrenador(); }
    match /logrosPersonales/{doc} { allow read, write: if esEntrenador(); }
    match /configVideo/{doc} { allow read, write: if esEntrenador(); }

    // El banco de ejercicios (nombre, alias, músculos y la RUTA de su GIF). Es catálogo, no
    // dato personal: lo lee cualquier sesión, como las insignias en storage.rules, y por eso
    // no paga el `get` de `sesionVigente`. Lo escribe el script de carga del entrenador
    // (functions/scripts/cargarBancoEjercicios.mjs) con el Admin SDK.
    match /ejercicios/{doc} {
      allow read: if request.auth != null;
      allow write: if esEntrenador();
    }

    // Avisos que el entrenador manda desde la app. Son cola y a la vez historial: la función
    // `enviarNotificacion` los toma al crearse y les anota el resultado.
    match /notificaciones/{doc} { allow read, write: if esEntrenador(); }
  }
}
